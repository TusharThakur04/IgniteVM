{
  "name": "igniteVM",
  "version": "1.0.0",
  "description": "sandboxing-infrasture",
  "keywords": [
    "sandboxing",
    "firecracker",
    "VMs"
  ],
  "homepage": "https://github.com/TusharThakur04/IgniteVM#readme",
  "bugs": {
    "url": "https://github.com/TusharThakur04/IgniteVM/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TusharThakur04/IgniteVM.git"
  },
  "license": "ISC",
  "author": "Tushar",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:agent": "bun build ./src/envd/index.ts --compile --outfile ./src/envd/envd",
    "build:rootfs": "npm run build:agent && ./src/envd/build-image.sh",
    "setup:network": "./src/scripts/network-setup.sh",
    "clean:network": "./src/scripts/network-cleanup.sh",
    "clean:sockets": "rm -f /tmp/fc-vm-*.socket",
    "clean:all": "npm run clean:sockets && npm run clean:network"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
